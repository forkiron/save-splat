# Copy to .env.local (gitignored) and fill in ONE of these. Restart `npm run dev` after changing.
#
# NOTE the absence of a VITE_ prefix. That is deliberate and load-bearing: Vite inlines any
# VITE_-prefixed variable into the client bundle, which would ship the key to every visitor.
# These are read only in the dev server's Node process, by server/swarm/plugin.ts.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=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

# optional
# SWARM_PROVIDER=openai      # pin the provider; otherwise whichever key is present wins
# SWARM_MODEL=               # pin the model; otherwise the account is asked what it can run
# SWARM_EFFORT=high          # anthropic only
